# Build output
/bin/
/dist/

# Generated Windows resources: the icon is drawn by ./cmd/gen-icon and the .syso
# objects are compiled from it, so both are build output rather than source.
*.syso
/packaging/windows/ledgerline.ico

# Go
*.test
*.out
coverage.txt

# Editor / OS
.DS_Store
.idea/
.vscode/

# Secrets (defense-in-depth; the CLI keeps credentials in the OS keychain, but
# never let a stray key or env file be committed)
.env
.env.*
*.pem
*.key
*token*
.claude/checkpoints/
